target/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
harness/out/
# build output: a stray dist/ would make the next build stamp itself dirty (#109)
dist/
.worktrees/

# LaTeX build outputs for the paper
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.synctex.gz
paper/*.fdb_latexmk
paper/*.fls
paper/main.pdf

# raw Binance recordings stay local: the repo goes public and republishing book data is a licensing risk (#4)
harness/fixtures/recorded/
# so do downloaded archive days (#23): the import tests read any found here
harness/fixtures/archives/

# credentials never enter the repo: it is public from 2026-10-25
.env
.env.*
kaggle.json
access_token
*.pem
*.key
